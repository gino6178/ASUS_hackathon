# LLM server, OpenAI-compatible. Default: Ollama on the station's GPU (see ../server/start.sh).
LLM_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b-instruct
LLM_DEVICE=GPU
# On the Intel Arc Pro B70: the OpenVINO GenAI server in ../llm-server (BACKEND=openvino ../server/start.sh)
# LLM_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen3-4B-int4-ov
# Embeddings for the research knowledge base (Ollama)
EMBED_MODEL=qwen3-embedding:0.6b
# Telegram: create a bot with @BotFather and paste its token here (keep this file private)
TELEGRAM_BOT_TOKEN=
# Gateway port and the web app origins allowed to call it
PORT=8787
ALLOW_ORIGINS=http://127.0.0.1:5190,http://localhost:5190
# Nightly research run and reflection run (hour, local time); 1 = adopt proposals that pass every gate
RESEARCH_HOUR=3
EVOLVE_HOUR=4
EVOLVE_AUTO=1
